---
permalink: /search.json
sitemap: false
---
{%- assign sep = "" -%}
[
{%- for sec in site.data.publications.sections -%}{%- for e in sec.entries -%}{%- if e.title and e.url -%}
{{ sep }}{"k":"p","t":{{ e.title | jsonify }},"s":{{ sec.title | jsonify }},"u":{{ e.url | jsonify }}}
{%- assign sep = "," -%}
{%- endif -%}{%- endfor -%}{%- endfor -%}
{%- for c in site.data.media_cards.cards -%}{%- if c.title and c.url -%}
{{ sep }}{"k":"m","t":{{ c.title | jsonify }},"s":{{ c.outlet | jsonify }},"u":{{ c.url | jsonify }}}
{%- assign sep = "," -%}
{%- endif -%}{%- endfor -%}
{%- for p in site.data.projects -%}
{{ sep }}{"k":"r","t":{{ site.data.i18n.en[p.title_key] | jsonify }},"ti":{"en":{{ site.data.i18n.en[p.title_key] | jsonify }},"ru":{{ site.data.i18n.ru[p.title_key] | jsonify }},"be":{{ site.data.i18n.be[p.title_key] | jsonify }}},"u":{{ p.url | jsonify }},"l":{% if p.local %}1{% else %}0{% endif %}}
{%- assign sep = "," -%}
{%- endfor -%}
]
